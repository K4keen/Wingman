# 复制成 .env 再用：cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥只放在 .env 里，永远不要提交。

POSTGRES_USER=wingman
POSTGRES_PASSWORD=wingman_dev
POSTGRES_DB=wingman
DATABASE_URL=postgresql+asyncpg://wingman:wingman_dev@localhost:5432/wingman
REDIS_URL=redis://localhost:6379/0

# 第 1 周写登录时用；生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# 第 3 周接真实模型时再填
ANTHROPIC_API_KEY=
